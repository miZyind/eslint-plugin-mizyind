{
  "name": "eslint-plugin-mizyind",
  "version": "0.0.0-development",
  "description": "This package provides miZyind's custom lint",
  "repository": "git@github.com:miZyind/eslint-plugin-mizyind.git",
  "author": "miZyind <mizyind.dev>",
  "license": "MIT",
  "homepage": "https://github.com/miZyind/eslint-plugin-mizyind#readme",
  "bugs": "https://github.com/miZyind/eslint-plugin-mizyind/issues",
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.js",
    "lint": "eslint --max-warnings 0",
    "semantic-release": "semantic-release"
  },
  "engines": {
    "node": ">=24",
    "yarn": "1.22.22"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@stylistic/eslint-plugin": "^6.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lodash.kebabcase": "^4.1.1",
    "minimatch": "^11.0.8",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "devDependencies": {
    "semantic-release": "^25.0.9"
  },
  "resolutions": {
    "eslint-plugin-react/minimatch": "^3.1.5",
    "minimatch": "^11.0.8"
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "eslint",
    "eslintplugin"
  ],
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "pkgRoot": "."
        }
      ],
      "@semantic-release/github"
    ]
  }
}
